{
  "dataset": {
    "title": "HUEN - ENTEBBE INTERNATIONAL AIRPORT - aerodrome (AD 2 scope)",
    "abstract": "AIXM 5.1.1 aerodrome data set for Entebbe International Airport, covering the aerodrome, runways and runway directions, landing thresholds and declared distances, taxiway and apron areas, radio navigation aids, communication channels and aerodrome services. Assembled from open data; geometry for taxiways and aprons is derived from observed aircraft ground tracks held in this repository. Not for operational use.",
    "location_indicator": "HUEN",
    "effective": "2026-10-26T00:00:00Z",
    "language": "eng",
    "publisher": "EBBs-FR24 (analysis project, unaffiliated with Uganda CAA)"
  },
  "sources": {
    "ourairports": {
      "name": "OurAirports open data set (airports/runways/navaids/frequencies)",
      "url": "https://github.com/davidmegginson/ourairports-data",
      "retrieved": "2026-10-26",
      "note": "Runway end coordinates, headings, elevations and navaid positions. OurAirports is DAFIF-derived and community-corrected; end coordinates are rounded to ~4 decimal places (~11 m), so lengths derived from them differ slightly from published runway lengths."
    },
    "dafif": {
      "name": "DAFIF figures as republished (Airports Worldwide, SkyVector)",
      "url": "https://www.airports-worldwide.com/uganda/entebbe_intl_uganda.php",
      "retrieved": "2026-10-26"
    },
    "chart": {
      "name": "HUEN aerodrome/AD 2 chart extract (declared distances, RFF, hours)",
      "url": "https://virtualairlines.eu/charts/HUEN.pdf",
      "retrieved": "2026-10-26",
      "note": "Secondary reproduction of the AIP AD 2.13 table and aerodrome chart. Used for declared distances, RFF category and H24 hours."
    },
    "tracks": {
      "name": "FR24 position tracks in this repository (tracks/, 350 flights)",
      "url": "https://github.com/jonathanbyakagaba/EBBs-FR24",
      "retrieved": "2026-10-26",
      "note": "Ground-level track points used to (a) verify the runway centrelines against published coordinates, (b) derive the east-side parallel taxiway offset and (c) derive apron envelopes. See scripts/track_crosscheck.py and out/track_crosscheck.md."
    },
    "wmm": {
      "name": "World Magnetic Model estimate for the ARP",
      "retrieved": "2026-10-26",
      "note": "Sources disagree on the declination at HUEN: DAFIF (2006) 0.0, a WMM2020-derived service 1.4 E (Jun 2026), another 1.7 E (2026), and the published magnetic runway headings imply ~2 E. Modelled as 1.0 E with wide accuracy and flagged in the validation report."
    }
  },
